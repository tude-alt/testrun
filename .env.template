# Mantic-only local configuration. Copy to .env and fill the required secrets.
# For GitHub Actions, put credentials in repository Actions secrets; a local
# .env file does not populate those secrets. Never commit a filled .env file.
# Mantic uses MANTIC_TOKEN. METACULUS_TOKEN is only for Metaculus modes.

# Required personal credentials
MANTIC_TOKEN=
AKASHML_API_KEY=
OPENROUTER_API_KEY=

# Mantic must not use donated inference credentials.
DONATED_OPENROUTER_KEY_ENABLED=false
GEMINI_USE_DONATED_OPENROUTER_KEY=false

# AkashML is primary; OpenRouter is the fallback. The external LiteLLM gateway
# and its LITELLM_API_KEY are not required by the corrected model configuration.
# Omit endpoint/model overrides to keep the defaults in llm_configs.py.
# AKASHML_API_BASE_URL=https://api.akashml.com/v1
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# To customize the forecasting roster, set BOTH lists with matching lengths
# and corresponding models in the same order. These are the shipped defaults:
# AKASHML_FORECAST_MODELS=zai-org/GLM-5.3,Qwen/Qwen3.6-35B-A3B,openai/gpt-oss-120b
# OPENROUTER_FORECAST_MODELS=z-ai/glm-5.3,qwen/qwen3.6-35b-a3b,openai/gpt-oss-120b
# AKASHML_UTILITY_MODEL=openai/gpt-oss-120b
# OPENROUTER_UTILITY_MODEL=openai/gpt-oss-120b
# AKASHML_FORECAST_MAX_TOKENS=16384
# AKASHML_UTILITY_MAX_TOKENS=8192
# Total timeout for primary + fallback, below FORECASTER_SOFT_DEADLINE:
# AKASHML_FORECAST_TIMEOUT=240
# AKASHML_UTILITY_TIMEOUT=120

# Optional research-provider credentials. These preserve the existing research
# paths; routing forecasting calls through AkashML does not replace web search.
ASKNEWS_CLIENT_ID=
ASKNEWS_SECRET=
PERPLEXITY_API_KEY=
EXA_API_KEY=
NIMBLE_API_KEY=
YDC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GCP_API_KEY_1=
GOOGLE_API_KEY=
FRED_API_KEY=
SEC_EDGAR_CONTACT_EMAIL=

# Azure is optional and needs all four settings when that route is used.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# AskNews pacing and retry settings from the supplied configuration.
ASKNEWS_MAX_CONCURRENCY=1
ASKNEWS_MAX_RPS=0.2
ASKNEWS_MAX_TRIES=3
ASKNEWS_BACKOFF_SECS=2.0

# Preserve the current workflow's independent research features.
NATIVE_SEARCH_ENABLED=true
FINANCIAL_DATA_ENABLED=true
GEMINI_VERTEX_MODEL=gemini-3.1-pro-preview
GEMINI_OPENROUTER_MODEL=google/gemini-3.1-pro-preview
GEMINI_SEARCH_MODEL=gemini-3.1-pro-preview
GEMINI_SEARCH_ENABLED=true
GAP_FILL_ENABLED=true
GAP_FILL_V2_ENABLED=true
PROBABILISTIC_TOOLS_ENABLED=false
PROBABILISTIC_TOOLS_TYPES=binary,multiple_choice
PREDICTION_MARKETS_ENABLED=true
RESOLUTION_SOURCE_ENABLED=true
RESOLUTION_SOURCE_URL_CONTEXT_ENABLED=true
TS_ANCHOR_ENABLED=true
TS_ANCHOR_CHART_ENABLED=false

# Preserve the existing aggregation behavior.
NUMERIC_STACKING_ENABLED=false
BINARY_STACKING_ENABLED=false
MC_STACKING_ENABLED=false

# Runtime/logging settings used by the workflow.
DISABLE_AIOHTTP_TRANSPORT=true
OPENAI_AGENTS_DISABLE_TRACING=true
PYTHONUNBUFFERED=1
PERSIST_RESEARCH_ENABLED=true
RAW_RESEARCH_LOG_ENABLED=true
